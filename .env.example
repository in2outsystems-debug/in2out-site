# URL pública do site (sem barra no final). Usada em sitemap, RSS, Open Graph e dados estruturados.
NEXT_PUBLIC_SITE_URL=https://in2out-site.vercel.app

# Webhook que recebe todos os formulários (n8n: nó "Webhook", método POST, resposta JSON).
FORM_WEBHOOK_URL=
# Segredo opcional enviado no cabeçalho x-webhook-secret para o n8n validar a origem.
FORM_WEBHOOK_SECRET=

# ID do contêiner do Google Tag Manager (GTM-XXXXXXX). O GA4 é configurado dentro do GTM.
NEXT_PUBLIC_GTM_ID=

# WhatsApp com DDI e DDD, só números.
NEXT_PUBLIC_WHATSAPP=5599984195490

# Link de agendamento da conversa de 30 minutos (Cal.com, Calendly etc.). Vazio mostra o placeholder.
NEXT_PUBLIC_AGENDA_URL=
